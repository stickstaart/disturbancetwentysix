{
  "rewrites": [
    { "source": "/__/auth/:path*", "destination": "https://disturbance-wpa.firebaseapp.com/__/auth/:path*" },
    { "source": "/__/firebase/:path*", "destination": "https://disturbance-wpa.firebaseapp.com/__/firebase/:path*" },
    { "source": "/((?!api/|__/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/stats-snapshot", "schedule": "20 4 * * *" }],
  "functions": { "api/stats-snapshot.ts": { "maxDuration": 60 } }
}
